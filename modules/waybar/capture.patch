+void waybar::modules::Wireplumber::setCapture(const Json::Value& state) {
+  capture_icon_ = Glib::Markup::escape_text(state["icon"].asString());
+  const auto details = state["details"].asString();
+  capture_details_ = details.empty() ? "" : "\n" + Glib::Markup::escape_text(details).raw();
+  auto style = label_.get_style_context();
+  if (state["multiple"].asBool()) {
+    style->add_class("multiple-captures");
+  } else {
+    style->remove_class("multiple-captures");
+  }
+  dp.emit();
+}
