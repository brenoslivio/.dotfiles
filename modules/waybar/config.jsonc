{
    "layer": "bottom",
    "position": "top",
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "height": 38,
    "spacing": 2,

    "modules-left": ["image#menu", "ext/workspaces", "hyprland/window"],
    "modules-center": ["custom/notification", "custom/clock", "custom/tasks"],
    "modules-right": ["custom/cava", "mpris", "wireplumber", "memory", "cpu", "tray", "backlight", "battery", "custom/displays", "custom/power"],

    "image#menu": {
        "path": "@nixosIcon@",
        "size": 26,
        // Re-render after transient image or output/scale changes.
        "interval": 30,
        "on-click": "~/.config/rofi/launch.sh",
        "tooltip": false
    },

    // Use the Wayland workspace protocol: Waybar 0.15's Hyprland click
    // handler sends legacy dispatch commands that Hyprland's Lua API rejects.
    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "󰖟",
            "2": "󰏫",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "external": "󰍺",
            "laptop": "󰍺",
            // "active": "\uf444",
            "default": "\uf4c3"
        },
        "sort-by-name": true,
        // Hyprland marks special workspaces hidden; keep them off the bar.
        // Persistent workspaces 1-6 are defined in hyprland.lua.
        "ignore-hidden": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 76,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true
    },

    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "restart-interval": 1,
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon}   {title}",
        "title-len": 52,
        "max-length": 54,
        "format-paused": "{status_icon} <i>{title}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "interval": 1,
        "ignored-players": ["brave"]
    },

    // "custom/research": {
    //     "exec": "~/.config/waybar/scripts/research.sh",
    //     "interval": 1,
    //     "return-type": "json",
    //     "format": "  <span size='large'>󰊪</span>    {}",
    //     "tooltip": true,
    //     "on-click": "obsidian"
    // },

    "custom/tasks": {
        "exec": "@taskControl@",
        "interval": 1,
        "return-type": "json",
        "format": "  {}",
        "tooltip": true,
        "on-click": "obsidian",
        "context-menu-command": "@taskControl@"
    },

    "custom/clock": {
        "format": "{}",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/clock.sh",
        "exec-if": "~/.config/waybar/scripts/clock.sh check",
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/clock.sh toggle",
        "signal": 1
    },

    "wireplumber": {
        "format": "<span size='large'>\udb81\udd7e</span>  {volume}%",
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "pavucontrol -t 3",
        "context-menu-command": "@audioControl@",
        "tooltip-format": "{node_name}\nRight-click to choose output or microphone"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "<span size='large'>{icon}</span>  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "custom/displays": {
        "exec": "~/.config/hypr/hyprdocked.sh status",
        "return-type": "json",
        "interval": 2,
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/hyprdocked.sh menu"
    },

    "backlight": {
        "format": "<span size='large'>\udb80\udcdf</span>  {percent}%",
        "scroll-step": 5,
    },

    "memory": {
        "interval": 1,
        "format": "<span size='large'></span>  {percentage}%"
    },

    "cpu": {
        "interval": 1,
        "format": "<span size='large'></span>  {usage}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 9
    },

    "custom/notification": {
        "tooltip-format": "Click to open notifications\nRight-click for Do Not Disturb",
        "format": "{icon}",
        "format-icons": {
          "notification": "<span foreground='#de0be6'><sup></sup></span>",
          "none": "",
          "dnd-notification": "<span foreground='#de0be6'><sup></sup></span>",
          "dnd-none": "",
          "inhibited-notification": "<span foreground='#de0be6'><sup></sup></span>",
          "inhibited-none": "",
          "dnd-inhibited-notification": "<span foreground='#de0be6'><sup></sup></span>",
          "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
      },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "wlogout"
    }
}
