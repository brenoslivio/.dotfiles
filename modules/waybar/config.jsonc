{
    "layer": "bottom",
    "position": "top",
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "height": 38,
    "spacing": 2,
    "spectrum-command": "@spectrumCommand@",

    "modules-left": ["image#menu", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/notification", "custom/updates", "custom/clock", "custom/tasks"],
    "modules-right": ["mpris", "wireplumber", "custom/memory", "custom/cpu", "tray", "backlight", "battery", "custom/displays", "custom/power"],

    "image#menu": {
        "path": "@nixosIcon@",
        "size": 26,
        // Re-render after transient image or output/scale changes.
        "interval": 30,
        "on-click": "~/.config/rofi/launch.sh",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "cursor": "pointer",
        "format-icons": {
            "1": "󰖟",
            "2": "󰏫",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "external": "󰍺",
            "laptop": "󰍺",
            // "active": "\uf444",
            "default": "\uf4c3"
        },
        "sort-by": "id"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 60,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true
    },

    "mpris": {
        "format": "{player_icon}   {title}",
        "title-len": 52,
        "max-length": 54,
        "format-paused": "{status_icon} <i>{title}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "interval": 1,
        "ignored-players": ["brave"]
    },

    // "custom/research": {
    //     "exec": "~/.config/waybar/scripts/research.sh",
    //     "interval": 1,
    //     "return-type": "json",
    //     "format": "  <span size='large'>󰊪</span>    {}",
    //     "tooltip": true,
    //     "on-click": "obsidian"
    // },

    "custom/tasks": {
        "exec": "@taskControl@",
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "image-path": "@taskIcon@",
        "icon-size": 18,
        "icon-spacing": 3,
        "tooltip": true,
        "on-click": "obsidian",
        "context-menu-command": "@taskControl@"
    },

    "custom/clock": {
        "format": "{}",
        "restart-interval": 2,
        "exec": "exec @clockControl@",
        "return-type": "json",
        "on-click": true,
        "exec-on-event": false,
        "calendar-popup": true,
        "context-menu-command": "@clockControl@"
    },

    "wireplumber": {
        "capture-command": "@captureMonitor@",
        "format": "<span font_family='FiraCode Nerd Font Mono' size='large'>{icon}</span>  {volume}<small>%</small>",
        "format-icons": {"default": "󰕾", "default-muted": "󰝟"},
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "pavucontrol -t 3",
        "context-menu-command": "@audioControl@",
        "tooltip-format": "{node_name}{capture_details}\nRight-click to choose output or microphone"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 30,
        "smooth-power": true,
        "format": "<span font_desc='FiraCode Nerd Font Propo 14'>{icon}</span>",
        "format-discharging": "<span font_desc='FiraCode Nerd Font Propo 14'>{icon}</span> {capacity}<small>%</small>",
        "format-charging": "<span font_desc='FiraCode Nerd Font Propo 14'>󰂄</span>",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{capacity}% · {timeTo}\nBattery health · {health}% of design capacity",
        "tooltip-format-discharging": "{capacity}% · On battery\n{power:.1f} W draw · {timeTo}",
        "tooltip-format-charging": "{capacity}% · Charging\n{power:.1f} W · {timeTo}\nBattery health · {health}% of design capacity",
        "tooltip-format-plugged": "{capacity}% · Plugged in · Charging paused\nBattery health · {health}% of design capacity",
        "tooltip-format-full": "{capacity}% · Fully charged\nBattery health · {health}% of design capacity"
    },

    "custom/displays": {
        "exec": "~/.config/hypr/hyprdocked.sh status",
        "return-type": "json",
        "interval": 2,
        "hide-empty-text": true,
        "on-click": "~/.config/hypr/hyprdocked.sh menu"
    },

    "backlight": {
        "format": "<span font_desc='FiraCode Nerd Font Propo 14'>{icon}</span>",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness · {percent}%",
        "scroll-step": 5
    },

    "custom/memory": {
        "exec": "@resourceMonitor@ memory",
        "return-type": "json",
        "restart-interval": 2,
        "align": 0.0,
        "format": "<span font_desc='FiraCode Nerd Font Propo 12'></span> {text:\u2007>2}<small>%</small>"
    },

    "custom/cpu": {
        "exec": "@resourceMonitor@ cpu",
        "return-type": "json",
        "restart-interval": 2,
        "align": 1.0,
        "format": "<span font_desc='FiraCode Nerd Font Propo 12'></span> {text:\u2007>2}<small>%</small>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 9
    },

    "custom/updates": {
        "exec": "@updateControl@ status",
        "on-click": "@updateControl@ manual",
        "context-menu-command": "@updateControl@",
        "signal": 9,
        "exec-on-event": false,
        "return-type": "json",
        "format": "{text}",
        "image-path": "@updateIcon@",
        "icon-size": 18,
        "icon-spacing": 0
    },

    "custom/notification": {
        "tooltip-format": "Click to open notifications\nRight-click for Do Not Disturb",
        "format": "●",
        "image-path": "@bellIcon@",
        "icon-size": 18,
        "icon-spacing": 0,
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
      },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "wlogout"
    }
}
