configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: "Search apps";
    display-calc: "Calculate";
    disable-history: false;
    terminal: "kitty";
    show-match: false;
}

* {
    font: "Inter 12";
    foreground: #f6edf8;
    muted: #cdb6d1;
    panel: #201424f2;
    field: #342037;
    selection: #592852;
    lavender: #d891ed;
    magenta: #de0be6;

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 540px;
    padding: 12px;
    border: 1px;
    border-color: @lavender;
    border-radius: 14px;
    background-color: @panel;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 10px;
    padding: 0;
}

inputbar {
    children: [ textbox-search, prompt, entry ];
    spacing: 10px;
    padding: 12px 14px;
    background-color: @field;
    border-radius: 8px;
}

textbox-search {
    str: "";
    font: "FiraCode Nerd Font Mono 15";
    text-color: @lavender;
    expand: false;
    vertical-align: 0.5;
}

prompt {
    text-color: @muted;
    vertical-align: 0.5;
}

entry {
    expand: true;
    vertical-align: 0.5;
    placeholder: "";
}

message {
    border: 0;
    padding: 3px 12px;
}

textbox {
    text-color: @muted;
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    border: 0;
    padding: 0;
    spacing: 3px;
}

element {
    spacing: 12px;
    padding: 8px 12px;
    border: 0 0 0 3px;
    border-color: transparent;
    border-radius: 7px;
}

element normal.normal, element alternate.normal,
element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @foreground;
}

element normal.urgent, element alternate.urgent {
    text-color: @lavender;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @selection;
    text-color: @foreground;
    border-color: @magenta;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold #f3b3ff;
}
